SetGridSize(4, 4, 1)
SetCellSize(4e-9, 4e-9, 2e-9)
SetNImages(2)

Aex = 13e-12
Alpha = 1
m = RandomMag()

Msat = 1100e3
K := 0.5e6
u := ConstVector(1, 0, 0)

prefactor := Const((2 * K) / (Msat.Average()))
MyAnis := Mul(prefactor, Mul(Dot(u, m), u))
AddFieldTerm(MyAnis)
AddEdensTerm(Mul(Const(-0.5), Dot(MyAnis, M_full)))

// B_ext.Set(Vector(0, 0.00, 0))
// Relax()

Save(m)
Snapshot(m)

